### 变量：默认使用 localhost:3000，可改为实际地址
@baseUrl = http://localhost:3000
@username = testuser
@password = 123456

### ============================================================
### 1. 注册
### ============================================================
POST {{baseUrl}}/api/register
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### ============================================================
### 2. 登录（获取 token）
### ============================================================
# @name login
POST {{baseUrl}}/api/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###
@token = {{login.response.body.data.token}}

### ============================================================
### 3. 获取用户信息
### ============================================================
GET {{baseUrl}}/api/user/info
Authorization: Bearer {{token}}

### ============================================================
### 4. 新建问卷
### ============================================================
# @name createSurvey
POST {{baseUrl}}/api/survey
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "用户满意度调查",
  "createDate": 1717000000000,
  "surveyCount": 0,
  "coms": [
    {
      "name": "text-note",
      "id": "a1b2c3d4-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
      "status": {
        "title": {
          "id": "uuid", "isShow": true, "name": "title-editor",
          "status": "欢迎参加本次调查"
        }
      }
    },
    {
      "name": "single-select",
      "id": "e5f6g7h8-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
      "status": {
        "title": {
          "id": "uuid", "isShow": true, "name": "title-editor",
          "status": "您的性别是？"
        },
        "options": {
          "id": "uuid", "isShow": true, "name": "options-editor",
          "currentStatus": 0, "status": ["男", "女", "保密"]
        }
      }
    }
  ]
}

###
@surveyId = {{createSurvey.response.body.data._id}}

### ============================================================
### 5. 获取问卷列表
### ============================================================
GET {{baseUrl}}/api/survey
Authorization: Bearer {{token}}

### ============================================================
### 6. 获取单个问卷
### ============================================================
GET {{baseUrl}}/api/survey/{{surveyId}}
Authorization: Bearer {{token}}

### ============================================================
### 7. 更新问卷
### ============================================================
POST {{baseUrl}}/api/survey
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "_id": "{{surveyId}}",
  "title": "用户满意度调查（修订版）",
  "surveyCount": 5,
  "coms": [
    {
      "name": "text-note",
      "id": "a1b2c3d4-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
      "status": {
        "title": {
          "id": "uuid", "isShow": true, "name": "title-editor",
          "status": "感谢参与本次调查！"
        }
      }
    }
  ]
}

### ============================================================
### 8. 删除问卷
### ============================================================
DELETE {{baseUrl}}/api/survey/{{surveyId}}
Authorization: Bearer {{token}}
